   "source": [
    "def my_brute(arr):\n",
    "    cnt = 0\n",
    "    for i in range(len(arr)):\n",
    "        if arr[i] == 1:\n",
    "            cnt+=1\n",
    "    \n",
    "    if cnt <=0:\n",
    "        print(\"NO 1 found\")\n",
    "    else:\n",
    "        return cnt\n",
    "    \n",
    "arr = [1,1,1,1,2,3,4,5]\n",
    "my_brute(arr)\n",
    "\n",
    "# T.C - O(N)\n",
    "# S.C - O(1)"
   ]
  },
