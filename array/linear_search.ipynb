   "source": [
    "def my_brute(arr, k):\n",
    "    for i in range(len(arr)):\n",
    "        if arr[i] == k:\n",
    "            return i\n",
    "\n",
    "arr = [1,2,3,4,5,]\n",
    "k = 3\n",
    "my_brute(arr, k)\n",
    "\n",
    "# T.C = O(N)\n",
    "# S.C = O(1)"
   ]
  }
