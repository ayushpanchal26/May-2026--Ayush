   "source": [
    "def my_brute(arr):\n",
    "    cnt = 0 \n",
    "    maxi = 0\n",
    "    n = len(arr)\n",
    "\n",
    "    for i in range(n):\n",
    "        if arr[i] == 1:\n",
    "            cnt +=1\n",
    "        else:\n",
    "            cnt = 0\n",
    "        maxi = max(maxi, cnt)\n",
    "    return maxi\n",
    "\n",
    "arr = [1,1,0,1,1,1]\n",
    "my_brute(arr)"
   ]
